# Public HTTPS origin this spike is reachable at, with no trailing slash.
# During the spike this is a tunnel URL, e.g. https://abc-123.trycloudflare.com
# It MUST match what you enter as the connector URL, because it is baked into
# the OAuth issuer, the resource indicator, and the redirect allowlist.
BASE_URL=http://localhost:3000
PORT=3000
