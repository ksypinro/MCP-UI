flowchart TB
    IN(["POST /mcp"]) --> OG["1 Origin guard"]
    OG --> PL["2 Pre-auth limiter<br/>by IP"]
    PL --> BP["3 Body parser<br/>JSON only, 64 KB"]
    BP --> CL{"4 RPC classifier<br/>any protected call<br/>in the batch?"}
    CL -->|"no"| PUB["Public handlers<br/>initialize, tools/list,<br/>ui:// reads, show_*"]
    CL -->|"yes"| CE["5 Credential extractor<br/>header only"]
    CE --> TV["6 Token validator<br/>introspection, aud, iss, exp, scope"]
    TV --> DV["7 DPoP verifier<br/>if cnf.jkt present"]
    DV --> AL["8 Post-auth limiter<br/>by grant"]
    AL --> POL["9 Tool policy engine<br/>scope, write budget"]
    POL --> TH["10 Tool handler"]
    TH --> EX["11 Exchange client<br/>token B cache"]
    EX --> DS[("Device Service")]
    CE -.->|"missing"| CH["Challenge adapter<br/>401, 403 or ChatGPT _meta"]
    TV -.->|"invalid"| CH
    DV -.->|"bad proof"| CH
    POL -.->|"scope short"| CH
    TH --> AU[("Audit emitter")]
