flowchart TB
    subgraph Z0 ["Zone 0: user device, untrusted"]
        direction TB
        TLW["Top-level browser window<br/>the only place credentials are typed"]
        subgraph HP ["Host page origin"]
            HUI["Host chat UI<br/>Connect card, approval modals"]
        end
        subgraph SB ["Sandbox origin"]
            SP["Sandbox proxy iframe"]
            VIEW["MCP App View<br/>holds no token"]
        end
        subgraph APP ["iOS app sandbox"]
            IOS["Auth module"]
            SE[("Secure Enclave<br/>DPoP key")]
            KC[("Keychain<br/>refresh token")]
        end
    end
    subgraph Z1 ["Zone 1: host vendor cloud"]
        HC["MCP client<br/>tokens, PKCE verifier, DPoP key"]
    end
    subgraph Z2 ["Zone 2: public edge"]
        WAF["CDN, WAF, TLS 1.3, HSTS"]
    end
    subgraph Z3 ["Zone 3: identity zone"]
        AS["Authorization Server"]
        ADB[("Auth DB<br/>hashed tokens, grants")]
    end
    subgraph Z4 ["Zone 4: resource zone"]
        RS["MCP Resource Server"]
        GW["REST API Gateway"]
        RC[("Redis<br/>rate limits, DPoP jti, caches")]
    end
    subgraph Z5 ["Zone 5: core zone"]
        DS["Device Service"]
        DDB[("Device DB")]
        AUD[("Audit log, append-only")]
    end
    KMS[("KMS / HSM<br/>signing keys, pepper")]
    EGR["Egress proxy<br/>public IPs only"]
    VIEW <-->|"postMessage, no credentials"| SP
    SP <-->|"source and origin checked"| HUI
