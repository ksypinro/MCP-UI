flowchart LR
    subgraph PUBAPI ["Public endpoints, auth.iot.example"]
        direction TB
        META["Metadata<br/>RFC 8414, OIDC alias, JWKS"]
        PAR["PAR endpoint, RFC 9126"]
        AUTHZ["Authorization endpoint<br/>validates request once"]
        UI["Login and consent UI<br/>frame-ancestors none"]
        TOK["Token endpoint<br/>grant router"]
        REV["Revocation, RFC 7009"]
        REG["DCR, deprecated<br/>hardened, capped"]
    end
    subgraph INT ["Internal endpoints, mTLS only"]
        direction TB
        INTRO["Introspection, RFC 7662"]
        TXE["Token exchange, RFC 8693"]
    end
    subgraph CORE ["Core services"]
        direction TB
        CLR["Client registry<br/>CIMD, pre-registered, DCR"]
        AUTHN["Authenticator<br/>passkeys, password + TOTP"]
        SESS["AS session manager"]
        CONS["Consent service<br/>per-client registry"]
        CODE["Code service"]
        GRANTS["Grant handlers<br/>code, refresh, jwt-bearer, exchange"]
        DPOP["DPoP verifier<br/>nonce, jti cache"]
        MINT["Token minter<br/>opaque + HMAC, JWT signer"]
        EVT["Revocation events"]
        RL["Rate limiter, risk engine"]
    end
    subgraph STORE ["Stores and dependencies"]
        direction TB
        ADB[("Auth DB")]
        KMS[("KMS / HSM")]
        REDIS[("Redis")]
        EGR["Egress proxy"]
    end
    AUTHZ --> CLR
    PAR --> CLR
    REG --> CLR
    AUTHZ --> UI
    UI --> AUTHN
    UI --> CONS
    AUTHN --> SESS
    CONS --> CODE
    TOK --> GRANTS
    TXE --> GRANTS
    INTRO --> MINT
    REV --> EVT
    GRANTS --> DPOP
    GRANTS --> MINT
    CLR --> EGR
    MINT --> KMS
    MINT --> ADB
    CODE --> ADB
    CONS --> ADB
    SESS --> ADB
    DPOP --> REDIS
    RL --> REDIS
    EVT --> REDIS
    META -.-> KMS
