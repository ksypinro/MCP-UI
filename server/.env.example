PORT=4000
# Directory PGlite persists to. Delete it to reset all accounts and devices.
DATABASE_PATH=./.data
# Access tokens are short-lived; revocation is checked against the session on
# every protected request, so shortening this is cheap.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Credential submissions per minute per address on the hosted authorization
# page and on dynamic client registration. The token endpoint is deliberately
# not limited by address: hosts call it from their own infrastructure on
# behalf of every one of their users.
AUTH_RATE_LIMIT_PER_MINUTE=20

# Authorization page views per minute per address. The page needs no account,
# writes a pending authorization and may fetch a client metadata document.
AUTHORIZE_VIEW_RATE_LIMIT_PER_MINUTE=60

# A duplicate refresh with an already-rotated token, by the same client, inside
# this window gets the identical response instead of revoking the grant.
REFRESH_GRACE_SECONDS=30

# off | trusted-header. trusted-header answers ChatGPT's unauthenticated tool
# calls with a tool-level challenge (_meta["mcp/www_authenticate"]) instead of
# an HTTP 401. Honoured only with TRUST_PROXY set, and only for requests your
# proxy marks with X-Verified-Client: chatgpt after verifying ChatGPT's mTLS
# client certificate. The proxy must strip that header from everything else.
CHATGPT_TOOL_CHALLENGE=off

# Three origins. Each defaults to BASE_URL (one origin, for development).
# In production give each its own hostname, and make them final before
# launch: hosts key their client registration by the issuer.
# AUTH_BASE_URL=https://auth.iot.example
# MCP_BASE_URL=https://mcp.iot.example
# API_BASE_URL=https://api.iot.example

# Key material: all three or none. Unset, the server creates keys.json beside
# the database (mode 0600). Back that file up; losing it makes every stored
# password unverifiable. Format: "<version>:<base64 of 32+ bytes>", current
# pepper first in TOKEN_PEPPERS.
# TOKEN_PEPPERS=2:...,1:...
# PASSWORD_PEPPER=1:...
# INTERNAL_MAC_KEY=...

# Metadata-document clients shown as verified on the consent screen.
# KNOWN_CLIENTS=https://claude.ai/oauth/mcp-oauth-client-metadata,https://chatgpt.com/oauth/client.json

# true: issue refresh tokens only to clients that request offline_access.
REQUIRE_OFFLINE_ACCESS_FOR_REFRESH=false

# Password hashing cost (Argon2id). Lower only for local experiments.
# ARGON2_MEMORY_KIB=65536
# ARGON2_TIME_COST=3

# Internal-token signing keys: a JSON array of private P-256 JWKs, current
# first. Unset, they live in the key file (or per process).
# SIGNING_KEYS=[{"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}]

# report | enforce. enforce refuses writes over budget: 6 switches a minute
# per device, 20 a minute and 10 new devices an hour per grant.
WRITE_BUDGETS=report

# The iOS app's access tokens, in seconds (they are DPoP-bound and held only
# in memory; the app refreshes before they lapse).
# NATIVE_ACCESS_TOKEN_TTL_SECONDS=600

# on | deprecated | off. The password endpoints the old app used:
# /v1/auth/signup, login and refresh. deprecated answers with Deprecation and
# Sunset headers; off returns 410 (me and logout keep working).
LEGACY_FIRST_PARTY_AUTH=deprecated

# on: the REST API accepts only DPoP-bound tokens. Turn on once no installed
# app still uses the legacy endpoints.
DPOP_REQUIRED_FOR_API=off

# The app's OAuth callbacks, comma separated. Default: the custom scheme, and
# the universal link on API_BASE_URL.
# FIRST_PARTY_REDIRECT_URIS=com.example.iotswitch:/oauth/callback,https://api.iot.example/oauth/callback

# Publish /.well-known/apple-app-site-association for the universal-link
# callback. Without APPLE_TEAM_ID nothing is published.
# APPLE_TEAM_ID=ABCDE12345
# APPLE_BUNDLE_ID=com.example.IoTSwitch

# --- Phase 4: production infrastructure ---------------------------------

# A PostgreSQL server instead of PGlite. DATABASE_SCHEMA puts the tables in a
# schema of their own; DATABASE_POOL_SIZE is connections per process.
# DATABASE_URL=postgres://iotsw:iotsw@localhost:5432/iotsw
# DATABASE_SCHEMA=
# DATABASE_POOL_SIZE=10

# Shared rate limits, DPoP replay ids, sealed refresh responses and revocation
# events, so more than one process can serve traffic. Fails closed: if Redis
# is down, requests get 503.
# REDIS_URL=redis://localhost:6379
# REDIS_PREFIX=iotsw:
# REDIS_COMMAND_TIMEOUT_MS=500

# Key material through a KMS. Only "local" (a software stand-in) exists until
# the cloud provider is chosen (gate G4).
# KMS_PROVIDER=local
# LOCAL_KMS_FILE=./.data/local-kms.json
# KMS_KEY_FILE=./.data/keys.kms.json

# Prometheus metrics on their own listener, loopback by default.
# METRICS_PORT=9100
# METRICS_HOST=127.0.0.1
# DPOP_REPLAY_ALERT_PER_MINUTE=10

# Profile M (src/entry/*.ts): internal mTLS between the processes.
# TLS_CERT=  TLS_KEY=  TLS_CA=
# INTERNAL_PORT=9443                       # authorization server, internal listener
# AUTH_INTERNAL_URL=https://as:9443        # MCP resource server and API gateway
# DEVICE_SERVICE_URL=https://ds:9444       # MCP resource server and API gateway
# JWKS_URL=http://as:4000/.well-known/jwks.json   # Device Service
